# Supabase connection for the frontend.
# Both values are safe to expose in the client: the publishable/anon key is
# public by design, and row-level security (see supabase/schema.sql) is what
# actually protects the data. NEVER put the service_role / secret key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
